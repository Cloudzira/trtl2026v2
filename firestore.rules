rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMaster() { return signedIn() && request.auth.uid == 'f052KArayTV2290T3ljKLpON68v1'; }
    function isOwner(sid) { return signedIn() && request.auth.uid == sid; }
    function approved(sid) {
      return get(/databases/$(database)/documents/schools/$(sid)).data.status == 'approved';
    }

    match /schools/{sid} {
      // Sekolah hanya membaca dokumennya sendiri; master membaca semua sekolah
      allow read: if isMaster() || isOwner(sid);
      // Pendaftaran: email harus terverifikasi, status awal selalu "pending"
      allow create: if isOwner(sid)
        && request.auth.token.email_verified == true
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['name', 'npsn', 'city', 'email', 'status', 'createdAt']);
      // Hanya master yang boleh menyetujui / menolak / menangguhkan
      allow update, delete: if isMaster();

      // Data siswa & presensi: hanya pemilik sekolah yang sudah DISETUJUI master
      match /students/{id} {
        allow read, write: if isOwner(sid) && approved(sid);
      }
      match /attendance/{id} {
        allow read, create, delete: if isOwner(sid) && approved(sid);
        allow update: if false;      // catatan hadir pertama tidak bisa ditimpa
      }
      match /settings/{id} {
        allow read, write: if isOwner(sid) && approved(sid);
      }
    }
  }
}
